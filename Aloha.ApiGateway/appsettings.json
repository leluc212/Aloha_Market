{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:18080/realms/AlohaTest",
    "Audience": "aloha-client"
  },
  "GatewayBaseUrl": "http://localhost:8080",
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/user/{**catch-all}" },
        "Transforms": [
          { "RequestHeader": "Api-Gateway", "Set": "true" },
          { "RequestHeadersCopy": true }
        ]
      },
      "categories-route": {
        "ClusterId": "category-cluster",
        "Match": { "Path": "/api/category/{**catch-all}" },
        "Transforms": [
          { "RequestHeader": "Api-Gateway", "Set": "true" },
          { "RequestHeadersCopy": true }
        ]
      },
      "locations-route": {
        "ClusterId": "location-cluster",
        "Match": { "Path": "/api/location/{**catch-all}" },
        "Transforms": [
          { "RequestHeader": "Api-Gateway", "Set": "true" },
          { "RequestHeadersCopy": true }
        ]
      },
      "posts-route": {
        "ClusterId": "post-cluster",
        "Match": { "Path": "/api/post/{**catch-all}" },
        "Transforms": [
          { "RequestHeader": "Api-Gateway", "Set": "true" },
          { "RequestHeadersCopy": true }
        ]
      },
      "plans-route": {
        "ClusterId": "plan-cluster",
        "Match": { "Path": "/api/plan/{**catch-all}" },
        "Transforms": [
          { "RequestHeader": "Api-Gateway", "Set": "true" },
          { "RequestHeadersCopy": true }
        ]
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payment/{**catch-all}" },
        "Transforms": [
          { "RequestHeader": "Api-Gateway", "Set": "true" },
          { "RequestHeadersCopy": true }
        ]
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": { "d": { "Address": "http://user:8080" } }
      },
      "category-cluster": {
        "Destinations": { "d": { "Address": "http://category:8080" } }
      },
      "location-cluster": {
        "Destinations": { "d": { "Address": "http://location:8080" } }
      },
      "post-cluster": {
        "Destinations": { "d": { "Address": "http://post:8080" } }
      },
      "plan-cluster": {
        "Destinations": { "d": { "Address": "http://plan:8080" } }
      },
      "payment-cluster": {
        "Destinations": { "d": { "Address": "http://payment:8080" } }
      }
    }
  }
}
